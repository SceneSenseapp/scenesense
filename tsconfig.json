{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "preserve",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"]
    },
    "types": [
      "node"
    ]
  },
  "include": [
    "next-env.d.js",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
, "app/api/movie/[id]/route.js", "app/api/actor/[id]/route.js", "components/MovieCard.jsx", "hooks/useWatchlist.js", "--template/next.config.js", "prisma.config.js", "playwright.config.js", "--template/next-env.d.js", ".next/types/cache-life.d.js"  ],
  "exclude": ["node_modules"]
}
