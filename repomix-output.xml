// components/MovieModal.jsx
"use client";

import { useState, useEffect } from 'react';
import Image from 'next/image';
import { useRouter } from 'next/navigation';
import { useWatchlist } from '@/hooks/useWatchlist';

const TMDB_API_KEY = process.env.NEXT_PUBLIC_TMDB_API_KEY;
const AMAZON_AFFILIATE_TAG = process.env.NEXT_PUBLIC_AMAZON_TAG || 'scenesense-20'; // Live affiliate tag integration

export default function MovieModal({ movieId, onClose }) {
  const [movie, setMovie] = useState(null);
  const [cast, setCast] = useState([]);
  const [crew, setCrew] = useState([]);
  const [trailerKey, setTrailerKey] = useState(null);
  const [similarMovies, setSimilarMovies] = useState([]);
  const [reviews, setReviews] = useState([]);
  const [isLoading, setIsLoading] = useState(true);
  const [playingTrailer, setPlayingTrailer] = useState(false);
  
  const router = useRouter();
  const { watchlist, saveToWatchlist, removeFromWatchlist } = useWatchlist();
  const isSaved = movie ? watchlist.some((item) => String(item.id) === String(movie.id)) : false;

  useEffect(() => {
    if (!movieId) return;
    setPlayingTrailer(false); // Reset play state when modal changes movie

    const fetchMovieData = async () => {
      setIsLoading(true);
      try {
        const [detailsRes, creditsRes, videosRes, similarRes, reviewsRes] = await Promise.all([
          fetch(`https://api.themoviedb.org/3/movie/${movieId}?api_key=${TMDB_API_KEY}`),
          fetch(`https://api.themoviedb.org/3/movie/${movieId}/credits?api_key=${TMDB_API_KEY}`),
          fetch(`https://api.themoviedb.org/3/movie/${movieId}/videos?api_key=${TMDB_API_KEY}`),
          fetch(`https://api.themoviedb.org/3/movie/${movieId}/similar?api_key=${TMDB_API_KEY}`),
          fetch(`https://api.themoviedb.org/3/movie/${movieId}/reviews?api_key=${TMDB_API_KEY}`)
        ]);

        const movieData = await detailsRes.json();
        const creditsData = await creditsRes.json();
        const videosData = await videosRes.json();
        const similarData = await similarRes.json();
        const reviewsData = await reviewsRes.json();

        const trailer = videosData.results?.find((v) => v.type === 'Trailer' && v.site === 'YouTube');
        const directorList = creditsData.crew?.filter(c => c.job === 'Director' || c.job === 'Writer' || c.job === 'Original Music Composer') || [];

        setMovie(movieData);
        setCast(creditsData.cast?.slice(0, 8) || []);
        setCrew(directorList.slice(0, 4));
        setTrailerKey(trailer ? trailer.key : null);
        setSimilarMovies(similarData.results?.slice(0, 6) || []);
        setReviews(reviewsData.results?.slice(0, 3) || []);
      } catch (error) {
        console.error("Failed to fetch cinematic telemetry:", error);
      } finally {
        setIsLoading(false);
      }
    };

    fetchMovieData();
  }, [movieId]);

  if (!movieId) return null;

  const formatCurrency = (amount) => {
    if (!amount || amount === 0) return 'N/A';
    return new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD', maximumFractionDigits: 0 }).format(amount);
  };

  const navigateToReviews = () => {
    if (!movie) return;
    router.push(`/reviews/${movie.id}?title=${encodeURIComponent(movie.title)}&poster=${movie.poster_path}`);
  };

  return (
    <div className="fixed inset-0 z-50 flex items-center justify-center bg-black/90 backdrop-blur-xl p-4 overflow-y-auto" role="dialog" aria-modal="true">
      
      {/* Cinematic Ambient Backdrop Glow Layer */}
      {movie?.backdrop_path && (
        <div className="absolute inset-0 overflow-hidden pointer-events-none opacity-25 z-0">
          <Image
            src={`https://image.tmdb.org/t/p/original${movie.backdrop_path}`}
            alt=""
            fill
            className="object-cover blur-3xl scale-125"
          />
        </div>
      )}

      <div className="bg-[#0b0b12]/95 border border-red-500/40 w-full max-w-5xl rounded-[32px] p-8 sm:p-12 relative shadow-[0_25px_80px_rgba(220,38,38,0.35)] my-8 space-y-10 animate-fadeIn text-white z-10">
        
        {/* Close Button */}
        <button 
          onClick={onClose} 
          className="absolute top-6 right-6 w-11 h-11 rounded-full bg-white/10 hover:bg-red-600 flex items-center justify-center text-white text-base font-bold transition-colors cursor-pointer z-10 shadow-lg"
        >
          ✕
        </button>

        {isLoading ? (
          <div className="flex flex-col items-center justify-center py-28 space-y-4">
            <div className="w-12 h-12 border-4 border-red-600 border-t-transparent rounded-full animate-spin"></div>
            <span className="text-xs font-mono text-red-400 uppercase tracking-widest">Scanning Film Telemetry...</span>
          </div>
        ) : !movie ? (
          <div className="text-center py-20 text-gray-400 text-sm">
            <p>Movie transmission not found.</p>
          </div>
        ) : (
          <div className="space-y-10 max-h-[82vh] overflow-y-auto pr-3 scrollbar-thin">
            
            {/* Header Navigation & Actions */}
            <div className="flex flex-col sm:flex-row items-center justify-between border-b border-white/10 pb-5 gap-4">
              <span className="text-xs font-mono tracking-widest uppercase text-red-400 font-bold">SCENESENSE OVERLAY BUBBLE</span>

              <div className="flex flex-wrap gap-3">
                <button
                  onClick={navigateToReviews}
                  className="px-4 py-2.5 bg-blue-600 hover:bg-blue-500 text-white text-xs font-bold rounded-xl transition-all shadow-[0_0_15px_rgba(37,99,235,0.3)] flex items-center gap-2 cursor-pointer"
                >
                  <span>💬 Log Review & AI Chat</span>
                </button>

                {/* Monetized Affiliate Link */}
                <a
                  href={`https://www.amazon.com/s?k=${encodeURIComponent(movie.title + ' blu-ray merchandise')}&tag=${AMAZON_AFFILIATE_TAG}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  className="px-4 py-2.5 bg-amber-600 hover:bg-amber-500 text-white text-xs font-black uppercase tracking-wider rounded-xl transition-all shadow-md flex items-center gap-1.5"
                >
                  <span>🛒 Shop on Amazon</span>
                </a>

                <button
                  onClick={() => (isSaved ? removeFromWatchlist(movie.id) : saveToWatchlist(movie))}
                  className={`px-4 py-2.5 rounded-xl text-xs font-bold transition-all cursor-pointer ${
                    isSaved ? 'bg-red-600 text-white' : 'bg-white/10 text-gray-300 hover:bg-white/20'
                  }`}
                >
                  {isSaved ? '📋 In Watchlist' : '📋 Add to Watchlist'}
                </button>
              </div>
            </div>

            {/* Movie Info Grid */}
            <div className="flex flex-col md:flex-row gap-8 items-center md:items-start">
              <div className="relative w-44 md:w-48 aspect-[2/3] rounded-2xl overflow-hidden bg-white/5 border border-white/15 flex-shrink-0 shadow-2xl">
                {movie.poster_path ? (
                  <Image
                    src={`https://image.tmdb.org/t/p/w500${movie.poster_path}`}
                    alt={movie.title}
                    fill
                    priority
                    loading="eager"
                    className="object-cover"
                  />
                ) : (
                  <div className="flex items-center justify-center h-full text-xs text-gray-500">No Image</div>
                )}
              </div>

              <div className="flex flex-col gap-4 flex-1 text-center md:text-left">
                <h1 className="text-3xl sm:text-4xl font-black">{movie.title}</h1>
                <p className="text-xs font-mono text-red-500 font-bold uppercase tracking-widest">
                  {movie.release_date ? movie.release_date.split('-')[0] : 'N/A'} • ★ {movie.vote_average ? movie.vote_average.toFixed(1) : 'N/A'} / 10 • {movie.runtime ? `${movie.runtime} min` : ''}
                </p>

                {movie.genres && (
                  <div className="flex flex-wrap gap-2 justify-center md:justify-start">
                    {movie.genres.map(g => (
                      <span key={g.id} className="px-2.5 py-1 bg-white/5 border border-white/10 rounded-full text-[10px] font-mono text-gray-300">{g.name}</span>
                    ))}
                  </div>
                )}

                <p className="text-sm text-gray-300 leading-relaxed font-light">{movie.overview}</p>
              </div>
            </div>

            {/* Financial & Technical Telemetry Bar */}
            <div className="grid grid-cols-2 sm:grid-cols-4 gap-4 bg-black/40 border border-white/10 rounded-2xl p-4 text-center font-mono">
              <div>
                <p className="text-[10px] text-gray-400 uppercase">Budget</p>
                <p className="text-xs sm:text-sm font-bold text-emerald-400">{formatCurrency(movie.budget)}</p>
              </div>
              <div>
                <p className="text-[10px] text-gray-400 uppercase">Box Office</p>
                <p className="text-xs sm:text-sm font-bold text-emerald-400">{formatCurrency(movie.revenue)}</p>
              </div>
              <div>
                <p className="text-[10px] text-gray-400 uppercase">Language</p>
                <p className="text-xs sm:text-sm font-bold uppercase">{movie.original_language || 'N/A'}</p>
              </div>
              <div>
                <p className="text-[10px] text-gray-400 uppercase">Status</p>
                <p className="text-xs sm:text-sm font-bold text-amber-400">{movie.status || 'Released'}</p>
              </div>
            </div>

            {/* Click-to-Play Zero-Lag Trailer Container */}
            {trailerKey && (
              <div className="w-full max-w-3xl mx-auto aspect-video bg-black rounded-2xl overflow-hidden border border-white/10 shadow-2xl relative transform-gpu translate-z-0 group">
                {playingTrailer ? (
                  <iframe
                    src={`https://www.youtube-nocookie.com/embed/${trailerKey}?autoplay=1&modestbranding=1&rel=0&playsinline=1`}
                    title="Movie Trailer"
                    className="w-full h-full absolute inset-0 border-0"
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                    allowFullScreen
                  ></iframe>
                ) : (
                  <div 
                    onClick={() => setPlayingTrailer(true)}
                    className="w-full h-full relative cursor-pointer flex items-center justify-center bg-cover bg-center group"
                    style={{ backgroundImage: `url('https://img.youtube.com/vi/${trailerKey}/maxresdefault.jpg')` }}
                  >
                    <div className="absolute inset-0 bg-black/40 group-hover:bg-black/20 transition-colors"></div>
                    <div className="relative z-10 w-16 h-16 rounded-full bg-red-600 flex items-center justify-center text-white text-2xl shadow-[0_0_30px_rgba(220,38,38,0.8)] group-hover:scale-110 transition-transform">
                      ▶
                    </div>
                    <span className="absolute bottom-4 left-4 text-xs font-mono font-bold text-white bg-black/70 px-3 py-1 rounded-lg backdrop-blur-md border border-white/10">
                      🎬 Play HD Trailer (Zero-Lag Mode)
                    </span>
                  </div>
                )}
              </div>
            )}

            {/* Director & Key Crew Telemetry */}
            {crew.length > 0 && (
              <div className="pt-4 border-t border-white/10">
                <h3 className="text-xs font-mono uppercase tracking-[0.2em] text-red-500 mb-3 font-bold">Key Production Crew</h3>
                <div className="flex flex-wrap gap-3">
                  {crew.map((member, idx) => (
                    <div key={idx} className="bg-black/50 border border-white/10 rounded-xl px-3 py-2 flex flex-col">
                      <span className="text-xs font-bold text-white">{member.name}</span>
                      <span className="text-[10px] font-mono text-red-400">{member.job}</span>
                    </div>
                  ))}
                </div>
              </div>
            )}

            {/* Key Cast & Actors */}
            {cast.length > 0 && (
              <div className="pt-6 border-t border-white/10">
                <h3 className="text-xs font-mono uppercase tracking-[0.2em] text-red-500 mb-6 font-bold">Key Cast &amp; Actors</h3>
                <div className="grid grid-cols-2 sm:grid-cols-4 md:grid-cols-8 gap-4">
                  {cast.map((actor) => (
                    <a
                      key={actor.id}
                      href={`https://www.themoviedb.org/person/${actor.id}`}
                      target="_blank"
                      rel="noopener noreferrer"
                      className="bg-black/60 border border-white/10 hover:border-red-500/60 rounded-2xl p-3 flex flex-col items-center text-center transition-all group shadow-md"
                    >
                      <div className="relative w-16 h-20 rounded-xl overflow-hidden bg-white/5 mb-3 shadow-md flex-shrink-0">
                        {actor.profile_path ? (
                          <Image src={`https://image.tmdb.org/t/p/w300${actor.profile_path}`} alt={actor.name} fill className="object-cover group-hover:scale-105 transition-transform" />
                        ) : (
                          <div className="flex items-center justify-center h-full text-[10px] text-gray-500">N/A</div>
                        )}
                      </div>
                      <div className="w-full space-y-0.5">
                        <p className="text-xs font-bold text-white group-hover:text-red-400 transition-colors leading-tight break-words">{actor.name}</p>
                        <p className="text-[10px] text-gray-400 leading-tight break-words">{actor.character || 'Actor'}</p>
                      </div>
                    </a>
                  ))}
                </div>
              </div>
            )}

            {/* Community Reviews Feed */}
            {reviews.length > 0 && (
              <div className="pt-6 border-t border-white/10 space-y-4">
                <h3 className="text-xs font-mono uppercase tracking-[0.2em] text-red-500 font-bold">Community Transmission &amp; Reviews</h3>
                <div className="grid grid-cols-1 md:grid-cols-3 gap-4">
                  {reviews.map((rev) => (
                    <div key={rev.id} className="bg-black/50 border border-white/10 rounded-2xl p-4 flex flex-col justify-between space-y-2">
