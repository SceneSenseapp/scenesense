  if (!user) return null;

  return (
    <div className="min-h-screen bg-[#050505] bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-[#2a0808] via-[#0a0a0a] to-black py-10 px-4 font-sans selection:bg-red-500/30">
