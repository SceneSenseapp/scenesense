    const nextIdx = (poolIndex + 3) % renderedPool.length;
    const nextBatch = [
      renderedPool[nextIdx % renderedPool.length],
      renderedPool[(nextIdx + 1) % renderedPool.length],
      renderedPool[(nextIdx + 2) % renderedPool.length]
