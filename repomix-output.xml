        <div className="bg-cover bg-center h-96 rounded-xl" style={{ backgroundImage: `url('https://images.unsplash.com/photo-1534447677768-be436bb09401?q=80&w=400&auto=format&fit=crop')` }}></div>
        <div className="bg-cover bg-center h-96 rounded-xl" style={{ backgroundImage: `url('https://images.unsplash.com/photo-1594909122845-11baa439b7bf?q=80&w=400&auto=format&fit=crop')` }}></div>
