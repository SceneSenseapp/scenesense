                      <div className="flex flex-wrap sm:flex-nowrap items-center gap-3 w-full sm:w-auto mt-4 sm:mt-0">
                        
                        <a 
                          href={`https://www.amazon.com/s?k=${encodeURIComponent(movie.title)}+movie+merchandise&tag=YOUR_AMAZON_TAG`}
