          onGoForward={goForward}
        />
      ) : (
        <>
          {media?.backdrop_path && (
            <div className="fixed inset-0 overflow-hidden pointer-events-none opacity-25 z-0">
              <Image
                src={`https://image.tmdb.org/t/p/original${media.backdrop_path}`}
                alt=""
                fill
                unoptimized
                priority
                className="object-cover blur-3xl scale-110"
              />
            </div>
