                        setShowtimesSources([]);
                      }}
                      className="bg-[#141418] border border-cyan-500/30 text-xs font-bold text-cyan-300 rounded-lg px-3 py-1.5 outline-none focus:border-cyan-400 cursor-pointer"
                    >
                      <option value="US">United States</option>
