<file path="components/profile/AvatarTab.jsx">
import { useState, useRef } from 'react';
import { updateProfile } from 'firebase/auth';
import { doc, setDoc, serverTimestamp } from 'firebase/firestore';
import { db } from '@/firebase';

const PRESET_AVATARS = [
  { name: 'Cyber Operative', url: 'https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?w=200' },
  { name: 'Neon Glitch', url: 'https://images.unsplash.com/photo-1570295999919-56ceb5ecca61?w=200' },
  { name: 'Void Walker', url: 'https://images.unsplash.com/photo-1494790108377-be9c29b29330?w=200' },
  { name: 'Grid Runner', url: 'https://images.unsplash.com/photo-1527980965255-d3b416303d12?w=200' }
];

export default function AvatarTab({ 
  user, 
  activeTheme, 
  avatarUrl, 
  setAvatarUrl, 
  showToast 
}) {
  const [isUploading, setIsUploading] = useState(false);
  const [urlInput, setUrlInput] = useState('');
  const [showUrlInput, setShowUrlInput] = useState(false);
  const fileInputRef = useRef(null);

  const saveAvatarToBackend = async (newUrl, isBase64 = false) => {
    try {
      if (!isBase64) {
        await updateProfile(user, { photoURL: newUrl }).catch((err) => console.log("Auth photo update skipped:", err));
      }
      
      const userRef = doc(db, 'users', user.uid);
      await setDoc(userRef, { photoURL: newUrl, updatedAt: serverTimestamp() }, { merge: true });
      
      setAvatarUrl(newUrl);
      showToast("Biometric avatar transmission complete.", "success");
    } catch (error) {
      console.error("CRITICAL: Failed to sync avatar profile to Firestore:", error);
      showToast("Database synchronization failed. Check Firestore rules.", "error");
    }
  }

  const handleAvatarUpload = async (e) => {
    if (!e.target.files || !e.target.files[0] || !user) return;
    const file = e.target.files[0];
    
    if (file.size > 1.5 * 1024 * 1024) {
      showToast("Transmission rejected: File exceeds 1.5MB limit.", "error");
      return;
    }

    setIsUploading(true);

    const reader = new FileReader();
    reader.onload = async (uploadEvent) => {
      try {
        const base64String = uploadEvent.target.result;
        await saveAvatarToBackend(base64String, true); // Flag as base64 to bypass Auth length limits
      } catch (error) {
        console.error("Local conversion failed:", error);
        showToast("Image processing failed.", "error");
      } finally {
        setIsUploading(false);
        if (fileInputRef.current) fileInputRef.current.value = "";
      }
    };

    reader.onerror = () => {
      setIsUploading(false);
      showToast("Failed to read local file.", "error");
    };

    reader.readAsDataURL(file);
  };

  const handleUrlSubmit = async (e) => {
    e.preventDefault();
    if (!urlInput.trim()) return;
    setIsUploading(true);
    try {
      await saveAvatarToBackend(urlInput.trim(), false);
      setUrlInput('');
      setShowUrlInput(false);
    } catch (error) {
      showToast("Invalid image URL format.", "error");
    } finally {
      setIsUploading(false);
    }
  };

  const handleClearAvatar = async () => {
    if (!user) return;
    try {
      await updateProfile(user, { photoURL: "" }).catch(() => {});
      const userRef = doc(db, 'users', user.uid);
      await setDoc(userRef, { photoURL: "", updatedAt: serverTimestamp() }, { merge: true });
      setAvatarUrl(null);
      showToast("Biometric avatar wiped from terminal.", "info");
    } catch (error) {
      console.error("Error clearing avatar:", error);
      showToast("Failed to clear biometric data.", "error");
    }
  };

  return (
    <div className="p-12 bg-[#0f0f0f]/80 min-h-[500px] flex flex-col items-center justify-center">
      <h2 className="text-sm font-black text-white mb-2 uppercase tracking-widest">Update Display Picture</h2>
      
      <p className="text-xs text-gray-400 mb-8 max-w-sm text-center">
        Upload station artwork, choose a preset, or link an external image transmission.
      </p>
      
      <div className="relative w-48 h-48 rounded-full overflow-hidden border-4 border-white/10 mb-8 bg-black shadow-2xl group">
        {avatarUrl ? (
          <img src={avatarUrl} alt="Avatar Preview" className="w-full h-full object-cover" />
        ) : (
          <div className="w-full h-full flex items-center justify-center text-7xl">👤</div>
        )}
      </div>

      {/* ACTION CONTROLS */}
      <div className="flex flex-wrap items-center justify-center gap-4 mb-6">
        <label className={`cursor-pointer ${activeTheme.bg} ${activeTheme.hoverBg} transition-all px-6 py-3 rounded-lg flex items-center gap-2 shadow-lg ${activeTheme.shadow}`}>
          <span className="text-white text-xs font-bold uppercase tracking-widest">
            {isUploading ? 'Transmitting...' : 'Upload File'}
          </span>
          <input 
            ref={fileInputRef}
            type="file" 
            accept="image/*" 
            onChange={handleAvatarUpload} 
            disabled={isUploading}
            className="hidden"
          />
        </label>

        <button 
          onClick={() => setShowUrlInput(!showUrlInput)}
          className="bg-[#1a1a1a] hover:bg-white/10 border border-white/10 text-white text-xs font-bold uppercase tracking-widest px-4 py-3 rounded-lg transition-all"
        >
          {showUrlInput ? 'Cancel URL' : 'Link URL'}
        </button>

        {avatarUrl && (
          <button 
            onClick={handleClearAvatar}
            className="bg-[#1a1a1a] hover:bg-red-950/40 hover:border-red-500 border border-white/10 text-gray-400 hover:text-red-400 text-xs font-bold uppercase tracking-widest px-4 py-3 rounded-lg transition-all"
          >
            Clear Photo
          </button>
        )}
      </div>

      {/* URL INPUT COLLAPSIBLE */}
      {showUrlInput && (
        <form onSubmit={handleUrlSubmit} className="flex gap-2 w-full max-w-md mb-6">
          <input 
            type="url"
            placeholder="https://example.com/image.jpg"
            value={urlInput}
            onChange={(e) => setUrlInput(e.target.value)}
            className="flex-1 bg-black border border-white/20 rounded-lg px-4 py-2 text-xs text-white focus:border-amber-500 outline-none"
          />
          <button type="submit" className="bg-amber-600 hover:bg-amber-500 text-black text-xs font-bold px-4 py-2 rounded-lg uppercase tracking-wider">
            Lock
          </button>
        </form>
      )}

      {/* PRESET AVATARS */}
      <div className="mt-4 border-t border-white/5 pt-6 w-full max-w-md text-center">
        <p className="text-[10px] text-gray-500 uppercase tracking-widest mb-3">Quick Preset Avatars</p>
        <div className="flex justify-center gap-3">
          {PRESET_AVATARS.map((preset) => (
            <button 
              key={preset.name}
              onClick={() => saveAvatarToBackend(preset.url, false)}
              className="w-12 h-12 rounded-full overflow-hidden border border-white/10 hover:border-amber-500 transition-all hover:scale-110 shadow-md"
              title={preset.name}
            >
              <img src={preset.url} alt={preset.name} className="w-full h-full object-cover" />
            </button>
          ))}
        </div>
      </div>
      
      <p className="text-[10px] text-gray-500 mt-6 uppercase tracking-wider">Supports JPG, PNG, WEBP (Max 1.5MB)</p>
    </div>
  );
}
</file>

<file path="components/profile/DashboardTab.jsx">
import { useState } from 'react';
import Image from 'next/image';
import { useRouter } from 'next/navigation';
import { doc, setDoc, collection, serverTimestamp } from 'firebase/firestore';
import { db } from '@/firebase';

const AFFILIATE_TAG = "scenesense-20";

export default function DashboardTab({ 
  user, 
  userRank, 
  activeTheme, 
  compactMode, 
  hoverGlow, 
  recentActivity, 
  radarItems, 
  activeBounties, 
  claimedBounties,
  showToast 
}) {
  const router = useRouter();
  const [imageErrors, setImageErrors] = useState({});

  const topMovieTitle = recentActivity?.[0]?.title || "sci-fi cyberpunk";
  const amazonAffiliateLink = `https://www.amazon.com/s?k=${encodeURIComponent(`${topMovieTitle} 4k steelbook bluray`)}&tag=${AFFILIATE_TAG}`;

  const claimBounty = async (bounty) => {
    if (!user) return;
    try {
      const claimRef = doc(collection(db, `users/${user.uid}/claims`));
      await setDoc(claimRef, {
        bountyId: bounty.id,
        movieId: bounty.movieId,
        movieTitle: bounty.movieTitle,
        pointsAwarded: bounty.rewardPoints,
        claimedAt: serverTimestamp()
      });
      showToast(`HVT Eliminated. ${bounty.rewardPoints} points transferred.`, "success");
    } catch (error) {
      console.error("Failed to secure bounty:", error);
      showToast("Bounty verification failed.", "error");
    }
  };

  const getImageUrl = (posterPath, size = 'w500') => {
    if (!posterPath) return '';
    if (posterPath.startsWith('http')) return posterPath;
    return `https://image.tmdb.org/t/p/${size}${posterPath.startsWith('/') ? '' : '/'}${posterPath}`;
  };

  const handleImageError = (id) => {
    setImageErrors(prev => ({ ...prev, [id]: true }));
  };

  return (
    <div className={`p-8 grid grid-cols-1 lg:grid-cols-3 gap-10 bg-[#0f0f0f]/80 ${compactMode ? 'py-4 gap-6' : ''}`}>
      <div className="lg:col-span-2">
        
        {/* OPERATIONAL BOUNTY BOARD */}
        <div className="mb-10">
          <div className="flex items-center justify-between mb-6">
            <h2 className="text-sm font-black text-white uppercase tracking-widest flex items-center gap-2">
              <span className="text-amber-500 animate-pulse">🎯</span> High-Value Targets
            </h2>
          </div>
          
          {activeBounties.length === 0 ? (
            <p className="text-xs text-gray-500 italic">No active targets on the board.</p>
          ) : (
            <div className="grid grid-cols-1 sm:grid-cols-2 gap-4">
              {activeBounties.map(bounty => {
                const isClaimed = claimedBounties.includes(bounty.id);
                return (
                  <div key={bounty.id} className={`p-5 rounded-xl border flex flex-col justify-between transition-all ${isClaimed ? 'bg-green-950/20 border-green-900/50' : 'bg-[#141414] border-white/10 hover:border-amber-500/50 shadow-lg'}`}>
                     <div>
                       <p className="text-[10px] uppercase tracking-widest text-gray-500 mb-1">Target Identity</p>
                       <h3 className={`text-sm font-black truncate ${isClaimed ? 'text-gray-400 line-through' : 'text-white'}`}>{bounty.movieTitle}</h3>
                       <p className="text-xs text-amber-400 font-bold mt-2">REWARD: {bounty.rewardPoints} PTS</p>
                     </div>
                     <button 
                       onClick={() => claimBounty(bounty)} 
                       disabled={isClaimed} 
                       className={`mt-4 w-full py-2.5 rounded-lg text-xs font-black uppercase tracking-wider transition-all ${
                         isClaimed 
                           ? 'bg-green-900/30 text-green-500 cursor-not-allowed border border-green-900/50' 
                           : 'bg-amber-600 hover:bg-amber-500 text-black shadow-[0_0_15px_rgba(245,158,11,0.2)]'
                       }`}
                     >
                       {isClaimed ? '✓ Bounty Secured' : 'Verify Kill'}
                     </button>
                  </div>
                )
              })}
            </div>
          )}
        </div>

        {/* TRANSMISSION LOG GRID */}
        <h2 className="text-sm font-black text-white mb-6 uppercase tracking-widest flex items-center gap-2">
          <span className={`w-2 h-2 rounded-full ${activeTheme.dot} animate-pulse`}></span> {userRank}&apos;s Transmission Log
        </h2>
        <div className="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-4">
          {recentActivity.map((movie, index) => {
            const posterSrc = getImageUrl(movie.poster_path, 'w500');
            const uniqueKey = movie.id ? `${movie.id}-${index}` : index;
            const hasError = imageErrors[movie.id];

            return (
              <div key={uniqueKey} className="flex flex-col group cursor-pointer" onClick={() => router.push(`/movie/${movie.id}`)}>
                <div style={{ position: 'relative', aspectRatio: '2/3' }} className="w-full rounded-xl overflow-hidden bg-[#1a1a1a] border border-white/5 transition-all duration-500 shadow-xl mb-3">
                  {movie.poster_path && !hasError ? (
                    <Image 
                      src={posterSrc} 
                      alt={movie.title} 
                      fill 
                      sizes="150px" 
                      priority={index < 5} 
                      onError={() => handleImageError(movie.id)}
                      className="object-cover group-hover:scale-110 transition-transform duration-700 ease-out"
                    />
                  ) : (
                    <div className="flex items-center justify-center h-full text-[10px] text-gray-400 p-2 text-center bg-gradient-to-br from-[#1a1a1a] to-[#0a0a0a]">
                      {movie.title}
                    </div>
                  )}
                </div>
                <h3 className="text-xs font-bold text-white leading-tight line-clamp-1">{movie.title}</h3>
              </div>
            );
          })}
        </div>
      </div>
      
      <div className="space-y-8">
        {/* RADAR TARGETS */}
        <div>
          <h2 className="text-sm font-black text-white mb-6 uppercase tracking-widest">Active Radar</h2>
          <div className="grid grid-cols-3 gap-3">
            {radarItems.map((movie, index) => {
              const radarSrc = getImageUrl(movie.poster_path, 'w200');
              const uniqueKey = movie.id ? `radar-${movie.id}-${index}` : `radar-${index}`;
              const hasError = imageErrors[`radar-${movie.id}`];

              return (
                <div key={uniqueKey} onClick={() => router.push(`/movie/${movie.id}`)} className="flex flex-col items-center group cursor-pointer">
                  <div style={{ position: 'relative', aspectRatio: '3/4' }} className={`w-full rounded-lg overflow-hidden bg-[#1a1a1a] border border-white/5 transition-all duration-300 shadow-md mb-2 ${hoverGlow ? activeTheme.borderGlow : ''}`}>
                    {movie.poster_path && !hasError ? (
                      <Image 
                        src={radarSrc} 
                        alt={movie.title} 
                        fill 
                        sizes="100px" 
                        onError={() => handleImageError(`radar-${movie.id}`)}
                        className="object-cover group-hover:scale-105 transition-transform duration-500" 
                      />
                    ) : (
                      <div className="flex items-center justify-center h-full text-[9px] text-gray-500 text-center p-1">
                        {movie.title}
                      </div>
                    )}
                  </div>
                  <h3 className="text-[10px] font-semibold text-gray-400 text-center line-clamp-1 group-hover:text-white transition-colors">
                    {movie.title}
                  </h3>
                </div>
              );
            })}
          </div>
        </div>

        {/* AFFILIATE MONETIZATION */}
        <div className="bg-gradient-to-br from-[#1a1a1a] to-[#0a0a0a] border border-amber-500/30 p-5 rounded-2xl relative overflow-hidden group">
          <div className="absolute top-0 right-0 w-32 h-32 bg-amber-500/5 rounded-full blur-2xl -mr-10 -mt-10 group-hover:bg-amber-500/10 transition-colors"></div>
          <h3 className="text-xs font-black text-amber-400 uppercase tracking-widest mb-2 relative z-10">Armoury Requisition</h3>
          <p className="text-[11px] text-gray-400 mb-4 font-medium leading-relaxed relative z-10">
            Secure the limited 4K Steelbook archive for <span className="text-white font-bold">{topMovieTitle}</span>.
          </p>
          <a 
            href={amazonAffiliateLink} 
            target="_blank" 
            rel="noopener noreferrer"
            className="block w-full py-2.5 bg-amber-500/10 border border-amber-500/40 text-amber-400 text-center text-xs font-black uppercase tracking-widest rounded-lg hover:bg-amber-500/20 hover:shadow-[0_0_15px_rgba(245,158,11,0.2)] transition-all relative z-10"
          >
            Access Armoury ↗
          </a>
        </div>
      </div>
    </div>
  );
}
</file>

<file path="components/profile/ReviewsTab.jsx">
import { useState } from 'react';
import { collection, addDoc, doc, deleteDoc, serverTimestamp } from 'firebase/firestore';
import { db } from '@/firebase';

const TMDB_API_KEY = process.env.NEXT_PUBLIC_TMDB_API_KEY;

export default function ReviewsTab({ user, activeTheme, reviews, showToast }) {
  // Localized State: Only exists when the Reviews tab is active
  const [reviewInput, setReviewInput] = useState('');
  const [isPublic, setIsPublic] = useState(true);
  const [reviewSearchQuery, setReviewSearchQuery] = useState('');
  const [reviewSearchResults, setReviewSearchResults] = useState([]);
  const [selectedReviewMovie, setSelectedReviewMovie] = useState(null);
  const [isSearchingMovie, setIsSearchingMovie] = useState(false);

  const searchMovieForReview = async (e) => {
    e.preventDefault();
    if (!reviewSearchQuery.trim()) return;
    
    setIsSearchingMovie(true);
    try {
      const res = await fetch(`https://api.themoviedb.org/3/search/movie?api_key=${TMDB_API_KEY}&query=${encodeURIComponent(reviewSearchQuery)}`);
      const data = await res.json();
      setReviewSearchResults(data.results?.slice(0, 5) || []);
    } catch (err) {
      console.error("Failed to query target database:", err);
      showToast("Radar connection failed.", "error");
    } finally {
      setIsSearchingMovie(false);
    }
  };

  const submitReview = async (e) => {
    e.preventDefault();
    if (!reviewInput.trim() || !user || !selectedReviewMovie) {
       showToast("Select a target and input transmission.", "error");
       return;
    }
    
    try {
      await addDoc(collection(db, 'reviews'), {
        userId: user.uid,
        authorName: user.displayName || 'Unknown Operative',
        text: reviewInput.trim(),
        isPublic: isPublic,
        movieId: selectedReviewMovie.id,
        movieTitle: selectedReviewMovie.title,
        moviePoster: selectedReviewMovie.poster_path,
        createdAt: serverTimestamp()
      });
      
      // Wipe local state after successful deployment
      setReviewInput('');
      setSelectedReviewMovie(null);
      setReviewSearchQuery('');
      setReviewSearchResults([]);
      
      showToast("Critique broadcast to archives.", "success");
    } catch (error) {
      console.error("Failed to broadcast review:", error);
      showToast("Log deployment failed.", "error");
    }
  };

  const handleDeleteReview = async (reviewId) => {
    if (!window.confirm("Confirm archive purge for this entry?")) return;
    try {
      await deleteDoc(doc(db, 'reviews', reviewId));
      showToast("Transmission log purged.", "info");
    } catch (error) {
      console.error("Failed to delete review:", error);
      showToast("Purge command failed.", "error");
    }
  };

  return (
    <div className="p-8 bg-[#0f0f0f]/80 min-h-[500px] max-w-3xl mx-auto">
       <h2 className="text-sm font-black text-white mb-6 uppercase tracking-widest flex items-center gap-2">Log a Movie Review</h2>
       
       {!selectedReviewMovie ? (
         <div className="mb-10 bg-[#141414] border border-white/10 rounded-xl p-5">
           <h3 className="text-xs font-bold text-gray-400 uppercase tracking-widest mb-3">1. Select Target</h3>
           <form onSubmit={searchMovieForReview} className="flex gap-2 mb-4">
             <input 
               type="text"
               value={reviewSearchQuery}
               onChange={(e) => setReviewSearchQuery(e.target.value)}
               placeholder="Search database for a movie..."
               className={`flex-1 bg-[#0a0a0a] text-sm text-gray-200 placeholder-gray-600 border border-white/5 rounded-lg px-4 py-2.5 focus:outline-none ${activeTheme.ring} transition-colors`}
             />
             <button type="submit" disabled={isSearchingMovie} className={`px-4 py-2.5 ${activeTheme.bg} ${activeTheme.hoverBg} text-white text-xs font-bold uppercase tracking-widest rounded-lg transition-all`}>
               {isSearchingMovie ? '...' : 'Search'}
             </button>
           </form>
           
           {reviewSearchResults.length > 0 && (
             <div className="flex flex-col gap-2">
               {reviewSearchResults.map(movie => (
                 <div key={movie.id} onClick={() => setSelectedReviewMovie(movie)} className="flex items-center gap-4 p-2 rounded-lg bg-[#1a1a1a] hover:bg-[#222] border border-white/5 cursor-pointer transition-colors group">
                   {movie.poster_path ? (
                     <img src={`https://image.tmdb.org/t/p/w92${movie.poster_path}`} alt={movie.title} className="w-10 h-14 object-cover rounded" />
                   ) : (
                     <div className="w-10 h-14 bg-[#2a2a2a] rounded flex items-center justify-center text-[8px] text-gray-500">N/A</div>
                   )}
                   <div>
                     <p className="text-sm font-bold text-white group-hover:text-emerald-400 transition-colors">{movie.title}</p>
                     <p className="text-xs text-gray-500">{movie.release_date?.split('-')[0]}</p>
                   </div>
                 </div>
               ))}
             </div>
           )}
         </div>
       ) : (
         <form onSubmit={submitReview} className="mb-10 bg-[#141414] border border-white/10 rounded-xl p-5">
           <div className="flex items-center justify-between mb-4 border-b border-white/5 pb-4">
             <div className="flex items-center gap-4">
               {selectedReviewMovie.poster_path ? (
                 <img src={`https://image.tmdb.org/t/p/w92${selectedReviewMovie.poster_path}`} alt={selectedReviewMovie.title} className="w-12 h-18 object-cover rounded shadow-md border border-white/10" />
               ) : (
                 <div className="w-12 h-18 bg-[#2a2a2a] rounded flex items-center justify-center text-[8px] text-gray-500 border border-white/10">N/A</div>
               )}
               <div>
                 <p className="text-[10px] text-red-500 font-bold uppercase tracking-widest mb-1">Active Target</p>
                 <h3 className="text-lg font-black text-white line-clamp-1">{selectedReviewMovie.title}</h3>
               </div>
             </div>
             <button type="button" onClick={() => { setSelectedReviewMovie(null); setReviewSearchResults([]); setReviewSearchQuery(''); }} className="text-[10px] text-gray-500 uppercase tracking-widest font-bold hover:text-white border border-white/10 px-3 py-1.5 rounded transition-colors bg-black/40">
               Change Target
             </button>
           </div>

           <textarea 
             value={reviewInput}
             onChange={(e) => setReviewInput(e.target.value)}
             placeholder="Input review transmission here (cinematography, narrative pacing, atmospheric score)..."
             className={`w-full bg-[#0a0a0a] text-sm text-gray-200 placeholder-gray-600 border border-white/5 rounded-lg p-4 mb-4 min-h-[120px] focus:outline-none ${activeTheme.ring} transition-colors resize-none`}
           />
           <div className="flex items-center justify-between">
             <label className="flex items-center gap-2 cursor-pointer group">
               <input 
                 type="checkbox" 
                 checked={isPublic}
                 onChange={(e) => setIsPublic(e.target.checked)}
                 className={`${activeTheme.accent} w-4 h-4 cursor-pointer`}
               />
               <span className="text-xs font-bold text-gray-400 uppercase tracking-widest group-hover:text-white transition-colors">
                 Make Public
               </span>
             </label>
             <button 
               type="submit" 
               disabled={!reviewInput.trim()}
               className={`px-6 py-2 ${activeTheme.bg} ${activeTheme.hoverBg} disabled:bg-gray-800 disabled:text-gray-500 text-white text-xs font-black uppercase tracking-widest rounded-lg shadow-lg transition-all`}
             >
               Deploy Log
             </button>
           </div>
         </form>
       )}

       <div className="space-y-4">
         <h3 className="text-xs font-black text-gray-500 uppercase tracking-widest border-b border-white/5 pb-2 mb-4">Transmission Archives</h3>
         {reviews.length === 0 ? (
           <p className="text-gray-500 text-sm italic">Transmission log empty. Enter and broadcast your initial critique above.</p>
         ) : (
           reviews.map((review) => (
             <div key={review.id} className="bg-[#1a1a1a] border border-white/5 rounded-lg p-5 flex flex-col gap-3 group relative">
               <div className="flex justify-between items-start gap-4">
                 <div className="flex gap-4 flex-1">
                   {review.moviePoster && (
                     <img src={`https://image.tmdb.org/t/p/w92${review.moviePoster}`} alt={review.movieTitle} className="w-12 h-18 object-cover rounded border border-white/10 hidden sm:block" />
                   )}
                   <div className="flex-1">
                     {review.movieTitle && <h4 className="text-xs font-black text-white uppercase tracking-widest mb-1">{review.movieTitle}</h4>}
                     <p className="text-sm text-gray-200 leading-relaxed whitespace-pre-wrap">{review.text}</p>
                   </div>
                 </div>
                 <button
                   onClick={() => handleDeleteReview(review.id)}
                   title="Purge transmission log"
                   className="opacity-0 group-hover:opacity-100 text-gray-500 hover:text-red-400 text-xs px-2 py-1 rounded border border-white/5 transition-opacity"
                 >
                   ✕
                 </button>
               </div>
               <div className="flex items-center gap-3 mt-1">
                 <span className={`text-[9px] font-bold uppercase tracking-widest px-2 py-0.5 rounded ${review.isPublic ? 'bg-green-500/10 text-green-400 border border-green-500/20' : 'bg-amber-500/10 text-amber-400 border border-amber-500/20'}`}>
                   {review.isPublic ? '🌐 Public Broadcast' : '🔒 Private Cache'}
                 </span>
                 <span className="text-[10px] text-gray-500">{review.date}</span>
               </div>
             </div>
           ))
         )}
       </div>
    </div>
  );
}
</file>

<file path="components/profile/SettingsTab.jsx">
export default function SettingsTab({
  userFaction,
  isProUser,
  activeTheme,
  accentPresets,
  displayNameInput,
