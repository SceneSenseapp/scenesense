        <div className="bg-cover bg-center h-96 rounded-xl" style={{ backgroundImage: `url('https://images.unsplash.com/photo-1489599849927-2ee91cede3ba?q=80&w=400&auto=format&fit=crop')` }}></div>
        <div className="bg-cover bg-center h-96 rounded-xl" style={{ backgroundImage: `url('https://images.unsplash.com/photo-1517604931442-7e0c8ed2963c?q=80&w=400&auto=format&fit=crop')` }}></div>
