"use client";

import { useState, useEffect } from 'react';
import { useRouter } from 'next/navigation';
import { 
  onAuthStateChanged, 
  signInWithEmailAndPassword, 
  createUserWithEmailAndPassword 
} from 'firebase/auth';
import { collection, addDoc, serverTimestamp } from 'firebase/firestore';
import { auth, db } from '@/firebase';
import { useWatchlist } from '@/hooks/useWatchlist';
import Image from 'next/image';
import MovieModal from '@/components/MovieModal';

const TMDB_API_KEY = process.env.NEXT_PUBLIC_TMDB_API_KEY;

const PERSONAS = [
  { id: 'Cinema Oracle Expert', label: '🔮 Cinema Oracle' },
  { id: 'Sci-Fi Vanguard', label: '⚡ Sci-Fi Vanguard' },
  { id: 'Noir Syndicate', label: '🕵️‍♂️ Noir Syndicate' },
  { id: 'Void Walkers', label: '🌌 Void Walkers' }
];

export default function HomePage() {
  const [user, setUser] = useState(null);
  const router = useRouter();
  
  // Recommender State
  const [mood, setMood] = useState('');
  const [persona, setPersona] = useState('Cinema Oracle Expert');
  const [isLoading, setIsLoading] = useState(false);
  const [recommendations, setRecommendations] = useState([]);
  const [trendingMovies, setTrendingMovies] = useState([]);

  // Routed Movie Modal State
  const [selectedMovieId, setSelectedMovieId] = useState(null);

  const { watchlist, saveToWatchlist, removeFromWatchlist } = useWatchlist();

  useEffect(() => {
    const unsubscribe = onAuthStateChanged(auth, (currentUser) => {
      setUser(currentUser);
    });
    return () => unsubscribe();
  }, []);

  // Check URL params for movieId on load
  useEffect(() => {
    const params = new URLSearchParams(window.location.search);
    const movieId = params.get('movieId');
    if (movieId) {
      setSelectedMovieId(movieId);
    }
  }, []);

  const openMovieModal = (movieId) => {
    if (!movieId) return;
    setSelectedMovieId(movieId);
    window.history.pushState(null, '', `?movieId=${movieId}`);
  };

  const closeMovieModal = () => {
    setSelectedMovieId(null);
    window.history.pushState(null, '', window.location.pathname);
  };

  // Fetch initial trending showcase
  useEffect(() => {
    const fetchTrending = async () => {
      try {
        const res = await fetch(`https://api.themoviedb.org/3/trending/movie/day?api_key=${TMDB_API_KEY}`);
        const data = await res.json();
        if (data.results) {
          setTrendingMovies(data.results.slice(0, 8));
        }
      } catch (error) {
        console.error("Failed to fetch trending showcase:", error);
      }
    };
    fetchTrending();
  }, []);

  const executeRecommendation = async (targetMood) => {
    const queryMood = targetMood || mood;
    if (!queryMood) return;

    setIsLoading(true);

    try {
      const res = await fetch('/api/recommend', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ mood: queryMood, persona })
      });
      
      const json = await res.json();
      if (json.success) {
        const movieList = json.data.movies || (json.data.movie ? [json.data.movie] : []);
        setRecommendations(movieList);

        if (user && movieList.length > 0) {
          const historyRef = collection(db, 'users', user.uid, 'history');
          await addDoc(historyRef, {
            mood: queryMood,
            persona,
            movieTitle: movieList[0].title,
            timestamp: serverTimestamp()
          });
        }
      } else {
        console.error("API Error:", json.error);
      }
    } catch (error) {
      console.error("Fetch failed:", error);
    } finally {
      setIsLoading(false);
    }
  };

  const toggleWatchlist = (movie, e) => {
    e.stopPropagation();
    const isSaved = watchlist.some(item => String(item.id) === String(movie.id));
