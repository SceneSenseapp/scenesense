"use client";

import { useState, useEffect } from 'react';
import { useRouter } from 'next/navigation';
import { onAuthStateChanged } from 'firebase/auth';
import { collection, getDocs, query, orderBy, limit } from 'firebase/firestore';
import { auth, db } from '@/firebase';

export default function ReviewsFeedPage() {
  const [user, setUser] = useState(null);
  const [reviews, setReviews] = useState([]);
  const [isLoading, setIsLoading] = useState(true);
  const router = useRouter();

  useEffect(() => {
    const unsubscribe = onAuthStateChanged(auth, (currentUser) => {
      if (currentUser) {
        setUser(currentUser);
        fetchReviews();
      } else {
        router.push('/where');
      }
    });
    return () => unsubscribe();
  }, [router]);

  const fetchReviews = async () => {
    setIsLoading(true);
    try {
      const q = query(collection(db, 'reviews'), orderBy('createdAt', 'desc'), limit(25));
      const querySnapshot = await getDocs(q);
      const fetchedReviews = [];
      querySnapshot.forEach((docSnap) => {
        fetchedReviews.push({
          id: docSnap.id,
          ...docSnap.data()
        });
      });
      setReviews(fetchedReviews);
    } catch (error) {
      console.error("Failed to retrieve community reviews:", error);
    } finally {
      setIsLoading(false);
    }
  };

  if (!user) return null;

  return (
    <div className="max-w-4xl mx-auto mt-10 p-6 min-h-[85vh] flex flex-col bg-[#0a0a0a] border border-red-950/60 rounded-2xl shadow-[0_0_50px_rgba(220,38,38,0.12)] relative overflow-hidden text-white">
      
      <div className="absolute top-0 left-0 w-full h-1.5 bg-gradient-to-r from-red-950 via-red-600 to-red-950 animate-pulse"></div>

      <div className="border-b border-[#2a2a2a] pb-4 mb-6 flex items-center justify-between z-10">
        <div>
          <h1 className="text-3xl font-black flex items-center gap-3 tracking-tight">
            <span className="text-red-600 animate-pulse">💬</span> Community Review Transmission
          </h1>
          <p className="text-gray-400 text-xs uppercase tracking-widest mt-1">Global Operative Film Logs &amp; Discussions</p>
        </div>
        <button
          onClick={() => router.push('/where')}
          className="px-4 py-2 bg-red-900/40 hover:bg-red-600 border border-red-800 text-xs font-bold rounded-xl text-red-200 transition-all cursor-pointer shadow-md"
        >
          📡 Return to Radar
        </button>
      </div>

      {isLoading ? (
        <div className="flex flex-col items-center justify-center py-28 space-y-4 flex-1">
          <div className="w-12 h-12 border-4 border-red-600 border-t-transparent rounded-full animate-spin"></div>
          <span className="text-xs font-mono text-red-400 uppercase tracking-widest">Synchronizing Review Transmissions...</span>
        </div>
      ) : reviews.length > 0 ? (
        <div className="space-y-4 z-10 flex-1 overflow-y-auto pr-2 scrollbar-thin">
          {reviews.map((rev) => (
            <div 
              key={rev.id}
              onClick={() => router.push(`/reviews/${rev.movieId}?title=${encodeURIComponent(rev.movieTitle || 'Film')}‰poster=${rev.posterPath || ''}`)}
              className="bg-[#121212] border border-[#2a2a2a] hover:border-red-500/60 rounded-xl p-5 flex flex-col gap-3 transition-all cursor-pointer group shadow-lg"
            >
              <div className="flex items-center justify-between border-b border-white/10 pb-3">
                <div className="flex items-center gap-3">
                  <span className="text-xs font-mono font-bold text-red-400 uppercase tracking-wider">{rev.movieTitle || 'Classified Film'}</span>
                  {rev.rating && (
                    <span className="px-2 py-0.5 bg-amber-500/10 border border-amber-500/30 rounded text-[10px] font-bold text-amber-400">
                      ★ {rev.rating} / 5
                    </span>
                  )}
                </div>
                <span className="text-[10px] font-mono text-gray-500">
                  {rev.createdAt?.toDate ? new Date(rev.createdAt.toDate()).toLocaleDateString() : 'Recent Transmission'}
                </span>
              </div>

              <p className="text-sm text-gray-300 leading-relaxed italic">&quot;{rev.reviewText || rev.content}&quot;</p>

              <div className="flex items-center justify-between pt-1">
                <span className="text-[10px] font-mono text-gray-400">Operative: {rev.userEmail || `...${rev.userId?.slice(-6)}` || 'Unknown'}</span>
                <span className="text-xs font-bold text-red-500 group-hover:underline">Access Discussion Thread →</span>
              </div>
            </div>
          ))}
        </div>
      ) : (
        <div className="py-24 text-center text-gray-400 text-xs flex-1 flex flex-col items-center justify-center">
          <p>No review transmissions logged in the database matrix yet.</p>
          <button
            onClick={() => router.push('/where')}
            className="mt-4 px-6 py-2.5 bg-red-600 hover:bg-red-700 text-white font-bold text-xs rounded-xl shadow-md transition-all cursor-pointer"
          >
            Explore Radar &amp; Log a Review
          </button>
        </div>
      )}

    </div>
  );
}
